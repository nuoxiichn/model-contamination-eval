{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/model-contamination-eval/detection-result.schema.json",
  "title": "DetectionResult",
  "type": "object",
  "required": ["method", "stage", "benchmark", "signal", "verdict_hint", "prerequisites_met", "evidence", "error"],
  "properties": {
    "method": {"type": "string"},
    "stage": {"type": "string", "enum": ["base", "sft", "rlhf"]},
    "benchmark": {"type": "string"},
    "signal": {"type": ["number", "null"]},
    "verdict_hint": {"type": "string", "enum": ["clean", "suspect", "dirty", "inconclusive"]},
    "prerequisites_met": {"type": "boolean"},
    "evidence": {"type": "object"},
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
